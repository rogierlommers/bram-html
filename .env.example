# generic configuration for the application
ADDR=:8080
BASE_URL=http://localhost:8080
DATA_DIR=data
STATIC_DIR=frontend
AUTH_RATE_LIMIT_PER_IP=5
AUTH_RATE_LIMIT_GLOBAL=100

# leave SMTP_HOST empty during development to print magic links to the console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=bram-html@example.com
