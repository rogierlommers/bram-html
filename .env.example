# generic configuration for the application
ADDR=:8080
BASE_URL=http://localhost:8080
DB_FILE=data/bram-html.db
STATIC_DIR=frontend
AUTH_RATE_LIMIT_PER_IP=5
AUTH_RATE_LIMIT_GLOBAL=100
AUTH_VERIFY_RATE_LIMIT_PER_IP=10
AUTH_VERIFY_RATE_LIMIT_GLOBAL=500
AUTH_CODE_SECRET=
ADMIN_EMAILS=

# leave SMTP_HOST empty during development to print login codes to the console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=bram-html@example.com
